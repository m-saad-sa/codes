import java.util.Scanner;

public class main{
	public static int calculate(int num1 , int num2) {    
        return num1 + num2 ;
}

	public static double calculate(double num1 , double num2) {
        return num1 + num2 ;
}

	public static int calculate(int num1 , int num2 , int num3) {
        return num1 + num2 + num3 ;
}
public static void main(String[] args){
	Scanner input = new Scanner(System.in);

    int choice ;
    System.out.println("select choice(1-3)");
    System.out.println("1.sum of 2 integers");
    System.out.println("2.sum of 2 decimal numbers");
    System.out.println("3.sum of 3 integers");

    choice = input.nextInt();
    
    if(choice == 1){
        System.out.println("Enter First number:");
        int a = input.nextInt();

        System.out.println("Enter Second number:");
        int b = input.nextInt();

        int result = calculate(a , b);
        System.out.println("sum : " + result);
    }
    else if(choice == 2){
       System.out.println("Enter First number:");
        double a = input.nextDouble();

        System.out.println("Enter Second number:");
        double b = input.nextDouble();

        double result = calculate(a,b);
         System.out.println("The sum is : " + result);
    }
    else if(choice == 3){
        System.out.println("Enter First number:");
        int a = input.nextInt();

        System.out.println("Enter Second number:");
        int b = input.nextInt();

        System.out.println("Enter Third number:");
        int c = input.nextInt();

        int result = calculate(a,b,c);
         System.out.println("The sum is : " + result);
    }
    else{
         System.out.println("invalid choice");
    }
} 
}
